{
  "kind": "claude_code",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Claude Code",
  "description": "Runs the local Claude Code CLI with per-output instructions, persistent sessions and application-managed MCP references.",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "model_catalog": [
    {
      "id": "",
      "label": "CLI default"
    },
    {
      "id": "sonnet",
      "label": "Sonnet"
    },
    {
      "id": "opus",
      "label": "Opus"
    },
    {
      "id": "haiku",
      "label": "Haiku"
    },
    {
      "id": "fable",
      "label": "Fable"
    }
  ],
  "effort_catalog": [
    "",
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "in",
        "title": "In",
        "accepts": [
          "message/*",
          "text/plain",
          "application/json"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "out",
        "title": "Out",
        "emits": [
          "message/*",
          "text/plain"
        ],
        "multiplicity": "many",
        "instruction": ""
      }
    ]
  },
  "config": {
    "claude_binary": "claude",
    "working_directory": "",
    "working_directory_input_enabled": false,
    "model": "",
    "effort": "",
    "permission_mode": "default",
    "dangerously_allow_all": false,
    "use_persistent_session": true,
    "session_generation": "",
    "instruction_inputs": {},
    "mcp_refs": [],
    "timeout_sec": 240,
    "max_prompt_chars": 250000
  },
  "port_capabilities": {
    "can_add_inputs": true,
    "can_add_outputs": true,
    "allow_required_input": true,
    "default_required": true
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs",
    "file_browser": true
  },
  "ui_assets": {
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ]
  }
}
